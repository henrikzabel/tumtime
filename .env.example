# Postgres connection string. Locally: the docker-compose database.
# On Supabase: use the "Transaction pooler" URI (port 6543) for Vercel.
DATABASE_URL=postgres://tumtime:tumtime@localhost:5433/tumtime

# Optional: enables Plausible analytics when set (e.g. tumtime.example).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Accounts & e-mail (club applications) ---
# Base URL used in e-mail links (defaults to VERCEL_URL or http://localhost:3000).
APP_URL=
# Resend API key; without it, e-mails (incl. login links) are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="TUM Time <noreply@your-domain.example>"
# Comma-separated e-mail addresses with admin rights (approve club claims).
ADMIN_EMAILS=
# Allowed login domains (subdomains included). Default: tum.de,mytum.de
ALLOWED_EMAIL_DOMAINS=
CRON_SECRET=
